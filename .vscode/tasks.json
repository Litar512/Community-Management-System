{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-tdtdf",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/g++.exe",
            "args": [
                "-std=c++17",
                "-g",
                "${workspaceFolder}/tdtdf.cpp",
                "-o",
                "${workspaceFolder}/tdtdf.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
